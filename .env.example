# Edge Add-ons Publish API (v1.1)
# Copy to .env (gitignored) and fill in. Never commit real secrets.
#
# Partner Center → Microsoft Edge → Publish API
# Product ID: Partner Center → your extension → Extension identity

EDGE_CLIENT_ID=
EDGE_API_KEY=
EDGE_PRODUCT_ID=

# Optional
# EDGE_ZIP=release/stitch-translate-1.0.2.zip
# EDGE_NOTES=Bugfix for page CSS interference; selection translate panel.
# EDGE_SKIP_SUBMIT=1
